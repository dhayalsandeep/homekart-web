# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this template is committed so the required keys stay documented.
# Never put a real token in .env.example.

# --- Shopify Storefront API (required for products, collections, search and cart) ---
# Admin > Settings > Apps and sales channels > Storefront API > Dev dashboard.
# The token shown there is the Storefront API access token; it is public by design
# but still must not be committed.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Defaults to 2026-10, the version this codebase was written against.
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# --- Site ---
# Used for canonical URLs, metadata and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
